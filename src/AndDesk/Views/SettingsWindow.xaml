<Window x:Class="AndDesk.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AndDesk.ViewModels"
        mc:Ignorable="d"
        Title="AndDesk — 设置"
        Height="540" Width="520"
        MinHeight="400" MinWidth="450"
        WindowStartupLocation="CenterOwner"
        Background="#F3F3F3"
        ResizeMode="NoResize"
        d:DataContext="{d:DesignInstance Type=viewmodels:SettingsViewModel}">

    <Window.Resources>
        <Style x:Key="SettingCard" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="6"/>
            <Setter Property="BorderBrush" Value="#E5E5E5"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="14,12"/>
            <Setter Property="Margin" Value="0,0,0,8"/>
        </Style>

        <Style x:Key="SectionTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Foreground" Value="#555"/>
            <Setter Property="Margin" Value="2,14,0,6"/>
        </Style>

        <Style x:Key="ItemTitle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="FontWeight" Value="Medium"/>
            <Setter Property="Foreground" Value="#1F1F1F"/>
        </Style>

        <Style x:Key="ItemDesc" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Foreground" Value="#666"/>
            <Setter Property="Margin" Value="0,2,0,0"/>
        </Style>
    </Window.Resources>

    <Grid Margin="18,12,18,16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Title Header -->
            <RowDefinition Height="*"/>    <!-- Scrollable Settings -->
            <RowDefinition Height="Auto"/> <!-- Bottom Buttons -->
        </Grid.RowDefinitions>

        <!-- Header -->
        <Border Grid.Row="0" Margin="0,0,0,10">
            <TextBlock Text="偏好设置" FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F"/>
        </Border>

        <!-- Settings List -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,-8,0" Padding="0,0,8,0">
            <StackPanel>
                <!-- Section 1: 启动与托盘 -->
                <TextBlock Text="🚀 启动与驻留" Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="开机时自动启动" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="在当前用户登录 Windows 时自动在后台运行" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding LaunchAtLogin, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="启动时最小化到托盘" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="运行后不弹出主窗口，直接驻留任务栏托盘区域" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding StartMinimized, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="关闭窗口时最小化到托盘" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="点击 [X] 按钮时隐藏主窗口并继续常驻，避免意外退出" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding CloseToTray, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Section 2: 桌面图标显隐策略 -->
                <TextBlock Text="👁 桌面图标控制" Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="启动时自动隐藏桌面图标" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="AndDesk 启动完成后立即自动隐藏 Windows 桌面图标" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding HideDesktopIconsOnLaunch, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="退出程序时恢复桌面图标" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="完全退出 AndDesk 时，尽最大努力恢复原始桌面图标显示" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding RestoreIconsOnExit, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>

                <!-- Section 3: 文件扫描 -->
                <TextBlock Text="📂 扫描与显示" Style="{StaticResource SectionTitle}"/>

                <Border Style="{StaticResource SettingCard}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="Auto"/>
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" VerticalAlignment="Center">
                            <TextBlock Text="显示隐藏项目" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="包含具有隐藏属性的文件或文件夹（系统关键文件仍会被安全排除）" Style="{StaticResource ItemDesc}"/>
                        </StackPanel>
                        <CheckBox Grid.Column="1" IsChecked="{Binding ShowHiddenFiles, Mode=TwoWay}" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <!-- Bottom Status and Close -->
        <Border Grid.Row="2" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#0078D4" VerticalAlignment="Center"/>

                <Button Grid.Column="1" Content="恢复默认" Command="{Binding ResetDefaultsCommand}"
                        Padding="12,6" Margin="0,0,8,0" Background="#F0F0F0" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>

                <Button Grid.Column="2" Content="完成" Click="CloseButton_Click"
                        Padding="16,6" Background="#0078D4" Foreground="White" BorderThickness="0" FontWeight="Medium" Cursor="Hand"/>
            </Grid>
        </Border>
    </Grid>
</Window>
