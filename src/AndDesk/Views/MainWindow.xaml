<Window x:Class="AndDesk.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewmodels="clr-namespace:AndDesk.ViewModels"
        xmlns:models="clr-namespace:AndDesk.Models"
        xmlns:tray="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        mc:Ignorable="d"
        Title="AndDesk — 桌面图标收纳与启动器"
        Height="680" Width="960"
        MinHeight="480" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}">

    <Window.Resources>
        <!-- Converters and Styles -->
        <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>

        <Style x:Key="CardHoverBorder" TargetType="Border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="BorderBrush" Value="#E0E0E0"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#F8F9FA"/>
                    <Setter Property="BorderBrush" Value="#0078D4"/>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/> <!-- Top Bar / Toolbar -->
            <RowDefinition Height="*"/>    <!-- Content: Grid or List -->
            <RowDefinition Height="Auto"/> <!-- Status Bar -->
        </Grid.RowDefinitions>

        <!-- Tray Icon Component -->
        <tray:TaskbarIcon x:Name="AppTrayIcon"
                          ToolTipText="AndDesk 桌面管理"
                          IconSource="/App.ico"
                          TrayLeftMouseDown="AppTrayIcon_TrayLeftMouseDown">
            <tray:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="打开主窗口" Click="TrayOpenWindow_Click" FontWeight="Bold"/>
                    <Separator/>
                    <MenuItem Header="隐藏桌面图标" Command="{Binding HideDesktopIconsCommand}"/>
                    <MenuItem Header="恢复桌面图标" Command="{Binding RestoreDesktopIconsCommand}"/>
                    <Separator/>
                    <MenuItem Header="设置" Command="{Binding OpenSettingsCommand}"/>
                    <Separator/>
                    <MenuItem Header="退出程序" Click="TrayExit_Click"/>
                </ContextMenu>
            </tray:TaskbarIcon.ContextMenu>
        </tray:TaskbarIcon>

        <!-- TOP TOOLBAR -->
        <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E5E5E5" BorderThickness="0,0,0,1" Padding="18,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="280"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Brand Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                    <TextBlock Text="AndDesk" FontSize="18" FontWeight="SemiBold" Foreground="#1F1F1F" VerticalAlignment="Center"/>
                    <Border Background="#E6F4EA" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center"
                            Visibility="{Binding IsDesktopHidden, Converter={StaticResource BoolToVisConverter}}">
                        <TextBlock Text="桌面图标已隐藏" FontSize="11" Foreground="#137333" FontWeight="Medium"/>
                    </Border>
                </StackPanel>

                <!-- Search Input Box -->
                <Border Grid.Column="1" Background="#F8F9FA" BorderBrush="#D1D5DB" BorderThickness="1" CornerRadius="6" Height="34">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="🔍" VerticalAlignment="Center" HorizontalAlignment="Center" FontSize="12" Foreground="#888"/>
                        <TextBox Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 BorderThickness="0" Background="Transparent" VerticalContentAlignment="Center"
                                 FontSize="13" Foreground="#222"/>
                        <TextBlock Grid.Column="1" Text="搜索桌面应用或文件..." VerticalAlignment="Center" Margin="2,0,0,0"
                                   Foreground="#9E9E9E" IsHitTestVisible="False" FontSize="13">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding SearchText}" Value="">
                                            <Setter Property="Visibility" Value="Visible"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </Border>

                <!-- Action Controls -->
                <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Refresh Button -->
                    <Button Content="🔄 刷新" Command="{Binding RefreshCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>

                    <!-- View Switch Button -->
                    <Button Content="切换视图" Command="{Binding ToggleViewModeCommand}" Height="34" Padding="12,0" Margin="0,0,8,0"
                            Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>

                    <!-- Settings Button -->
                    <Button Content="⚙ 设置" Command="{Binding OpenSettingsCommand}" Height="34" Padding="12,0" Margin="0,0,12,0"
                            Background="#FFFFFF" BorderBrush="#D1D5DB" BorderThickness="1" Cursor="Hand"/>

                    <!-- Desktop Icons Visibility Action -->
                    <Button Command="{Binding ToggleDesktopIconsCommand}" Height="34" Padding="14,0" Cursor="Hand" FontWeight="Medium">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#0078D4"/>
                                <Setter Property="Foreground" Value="White"/>
                                <Setter Property="BorderThickness" Value="0"/>
                                <Setter Property="Content" Value="👁 隐藏桌面图标"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDesktopHidden}" Value="True">
                                        <Setter Property="Background" Value="#0F7B0F"/>
                                        <Setter Property="Content" Value="✨ 恢复桌面图标"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN CONTENT AREA -->
        <Grid Grid.Row="1" Margin="16">
            <!-- 1. GRID VIEW MODE -->
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <ScrollViewer.Style>
                    <Style TargetType="ScrollViewer">
                        <Setter Property="Visibility" Value="Visible"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                <Setter Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ScrollViewer.Style>

                <ItemsControl ItemsSource="{Binding FilteredItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:DesktopItem}">
                            <Border Style="{StaticResource CardHoverBorder}" Width="105" Height="110" Margin="6"
                                    MouseLeftButtonDown="DesktopItem_MouseLeftButtonDown">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="56"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>

                                    <!-- App Icon -->
                                    <Image Grid.Row="0" Source="{Binding Icon}" Width="44" Height="44"
                                           VerticalAlignment="Center" HorizontalAlignment="Center"
                                           RenderOptions.BitmapScalingMode="HighQuality"/>

                                    <!-- App Title -->
                                    <TextBlock Grid.Row="1" Text="{Binding Name}" FontSize="12" Foreground="#2A2A2A"
                                               TextTrimming="CharacterEllipsis" TextWrapping="Wrap" MaxHeight="34"
                                               TextAlignment="Center" HorizontalAlignment="Center" VerticalAlignment="Top"/>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- 2. LIST VIEW MODE -->
            <ListView ItemsSource="{Binding FilteredItems}" BorderThickness="1" BorderBrush="#E0E0E0" Background="White"
                      MouseDoubleClick="ListView_MouseDoubleClick">
                <ListView.Style>
                    <Style TargetType="ListView">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding ViewMode}" Value="List">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </ListView.Style>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="图标" Width="50">
                            <GridViewColumn.CellTemplate>
                                <DataTemplate>
                                    <Image Source="{Binding Icon}" Width="24" Height="24" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </DataTemplate>
                            </GridViewColumn.CellTemplate>
                        </GridViewColumn>
                        <GridViewColumn Header="名称" DisplayMemberBinding="{Binding Name}" Width="280"/>
                        <GridViewColumn Header="类型" DisplayMemberBinding="{Binding DisplayType}" Width="140"/>
                        <GridViewColumn Header="来源" DisplayMemberBinding="{Binding SourceFolder}" Width="100"/>
                        <GridViewColumn Header="修改日期" DisplayMemberBinding="{Binding LastModified, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140"/>
                        <GridViewColumn Header="完整路径" DisplayMemberBinding="{Binding FullPath}" Width="300"/>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Empty List Watermark -->
            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding FilteredItems.Count}" Value="0">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                <TextBlock Text="📂" FontSize="40" HorizontalAlignment="Center" Margin="0,0,0,10"/>
                <TextBlock Text="未找到匹配的桌面项目" FontSize="15" Foreground="#666" HorizontalAlignment="Center"/>
            </StackPanel>
        </Grid>

        <!-- STATUS BAR -->
        <Border Grid.Row="2" Background="#FAFAFA" BorderBrush="#E5E5E5" BorderThickness="0,1,0,0" Padding="16,6">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0" Text="{Binding StatusMessage}" FontSize="12" Foreground="#555" VerticalAlignment="Center"/>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding FilteredCount, StringFormat=显示: {0}}" FontSize="12" Foreground="#666" Margin="0,0,12,0"/>
                    <TextBlock Text="{Binding TotalCount, StringFormat=总计: {0} 项}" FontSize="12" Foreground="#666"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
